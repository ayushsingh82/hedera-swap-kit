{
  "name": "hedera-swap-kit",
  "description": "Swap, pay, pay out and schedule on Hedera: SaucerSwap V2 swaps, payment links, batch payouts and auto-buy run by the Hedera Schedule Service, with a React component kit and a demo app.",
  "version": "0.1.0",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["hardhat"],
      "packageManager": ["npm", "yarn"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "hardhat",
      "packageManager": "npm"
    },
    "requirements": {
      "node": ">=20.18.3"
    },
    "outro": {
      "sections": [
        {
          "title": "Deploy and run",
          "steps": [
            {
              "label": "Create a deployer wallet",
              "command": "{run:init}"
            },
            {
              "label": "Fund it with testnet HBAR (about 20)",
              "url": "https://portal.hedera.com/faucet"
            },
            {
              "label": "Check the setup",
              "command": "{run:doctor}"
            },
            {
              "label": "Deploy the contracts to testnet",
              "command": "{run:deploy:testnet}"
            },
            {
              "label": "Start the app",
              "command": "{run:next:dev}"
            },
            {
              "label": "Try a use case from the command line",
              "command": "{run:demo:payout}"
            }
          ]
        }
      ]
    }
  }
}
