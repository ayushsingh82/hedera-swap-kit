# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run npm run generate or npm run account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Optional, for non-interactive scripts such as `npm run hardhat:swap-testnet`: an ECDSA key (0x-prefixed)
# for a throwaway testnet account. Get testnet HBAR at https://portal.hedera.com/faucet. Never commit .env.
__RUNTIME_DEPLOYER_PRIVATE_KEY=
